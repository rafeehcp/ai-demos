# Copy to backend/.env for local runs. On Render, set these in the dashboard.

# "openai_compat" calls a real provider; "fake" runs fully offline (no key needed).
LLM_PROVIDER=openai_compat
# Any OpenAI-compatible base URL. Default is Gemini's.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Required when LLM_PROVIDER=openai_compat. Get a free Gemini key at https://aistudio.google.com/apikey
LLM_API_KEY=
# Comma-separated. Later models are fallbacks when earlier ones are overloaded.
CHAT_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-flash-latest
EMBED_MODEL=gemini-embedding-001
# Optional. Sent as "dimensions" on embedding requests when set (for example 768).
EMBED_DIMENSIONS=

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Limits
MAX_SESSIONS=50
SESSION_TTL_MINUTES=30
MAX_DOCUMENTS=3
MAX_FILE_MB=10
MAX_PAGES=100
# Contract reviewer reads the whole contract in one model call.
CONTRACT_MAX_PAGES=40
TOP_K=6
# Uploads and questions combined, per IP.
RATE_LIMIT_PER_MINUTE=10
